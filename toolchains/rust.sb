;; Rust toolchain (rustup + cargo)
;;
;; rustup manages Rust installations at ~/.rustup/.
;; Its distribution state lives in ~/.rustup/{tmp,downloads,update-hashes,toolchains}/.
;; Those directories are writable so rust-toolchain.toml can select and install a
;; pinned channel; user-level defaults in ~/.rustup/settings.toml stay read-only.
;; cargo is the build tool and package manager at ~/.cargo/.
;; `cargo install` puts binaries in ~/.cargo/bin/.
;; Dependencies download to ~/.cargo/registry/ and ~/.cargo/git/.
;;
;; Linking native binaries needs the system C toolchain (clang/ld). The
;; /usr/bin/cc shims redirect to whatever `xcode-select` points at, so both
;; Xcode.app and Command Line Tools are granted read+exec below.

;; Exec — cargo, rustc, and cargo-installed binaries
(allow process-exec
  (subpath (string-append (param "HOME") "/.cargo/bin"))
  ;; rustup shims and toolchain binaries
  (subpath (string-append (param "HOME") "/.rustup")))

;; Exec — C toolchain (clang/ld) cargo invokes at link time. /usr/bin/cc
;; et al are shims that xcrun redirects to the active developer dir's real
;; clang/ld. Cover both Xcode.app and CLT to be xcode-select-agnostic.
(allow process-exec*
  (subpath "/Applications/Xcode.app")
  (subpath "/Library/Developer/CommandLineTools"))

;; Read — Xcode bundle (CLT read already covered by base /Library allow).
;; cc/xcrun read libxcrun.dylib from the active developer dir at link time.
(allow file-read-data
  (subpath "/Applications/Xcode.app"))

;; Read — full cargo home and rustup
(allow file-read-data
  (subpath (string-append (param "HOME") "/.cargo"))
  (subpath (string-append (param "HOME") "/.rustup")))

;; Write — rustup distributions, Cargo binaries, cache, and metadata
(allow file-write*
  ;; Transient channel hashes, manifests, and unpacking files.
  (subpath (string-append (param "HOME") "/.rustup/tmp"))
  ;; Persistent component archive cache used during toolchain installation.
  (subpath (string-append (param "HOME") "/.rustup/downloads"))
  ;; Per-channel hashes used to decide whether an installed channel is current.
  (subpath (string-append (param "HOME") "/.rustup/update-hashes"))
  ;; Rust compilers and components selected by rust-toolchain.toml.
  (subpath (string-append (param "HOME") "/.rustup/toolchains"))
  ;; `cargo install` writes compiled binaries here
  (subpath (string-append (param "HOME") "/.cargo/bin"))
  ;; crate registry index and downloaded crates
  (subpath (string-append (param "HOME") "/.cargo/registry"))
  ;; git-based dependencies
  (subpath (string-append (param "HOME") "/.cargo/git"))
  ;; package cache lock file
  (literal (string-append (param "HOME") "/.cargo/.package-cache"))
  ;; secondary package-cache mutex used by newer cargo
  (literal (string-append (param "HOME") "/.cargo/.package-cache-mutate"))
  ;; SQLite db backing cargo's gc.auto registry/source cache pruning
  (literal (string-append (param "HOME") "/.cargo/.global-cache"))
  ;; cargo install metadata — tracks which crates are installed
  (literal (string-append (param "HOME") "/.cargo/.crates.toml"))
  (literal (string-append (param "HOME") "/.cargo/.crates2.json")))

;; ============================================================
;; Codex-specific process execution
;; ============================================================
(allow process-exec
  ;; Direct release installs are commonly renamed to codex in ~/.local/bin.
  (subpath (string-append (param "HOME") "/.local/bin"))
  ;; npm installs under NVM use a JS launcher that spawns a vendored native binary.
  (subpath (string-append (param "HOME") "/.nvm"))
  ;; bun global installs use the same JS launcher/native-binary package shape.
  (subpath (string-append (param "HOME") "/.bun"))
  ;; Intel Homebrew cask installs symlink /usr/local/bin/codex to Caskroom.
  (literal "/usr/local/bin/codex")
  (subpath "/usr/local/Caskroom/codex")
  ;; Intel npm global installs use /usr/local/bin/node plus @openai/codex.
  (literal "/usr/local/bin/node")
  (subpath "/usr/local/lib/node_modules/@openai/codex"))

;; ============================================================
;; Codex-specific read permissions
;; ============================================================

;; Codex CLI binary locations
(allow file-read-data
  ;; Direct release installs are commonly renamed to codex in ~/.local/bin.
  (subpath (string-append (param "HOME") "/.local/bin"))
  ;; npm installs under NVM use a JS launcher and vendored native binary.
  (subpath (string-append (param "HOME") "/.nvm"))
  ;; bun global installs use ~/.bun/bin and ~/.bun/install/global.
  (subpath (string-append (param "HOME") "/.bun"))
  ;; Intel Homebrew cask and npm global install targets.
  (literal "/usr/local/bin/codex")
  (literal "/usr/local/bin/node")
  (subpath "/usr/local/Caskroom/codex")
  (subpath "/usr/local/lib/node_modules/@openai/codex"))

;; Codex config, auth, sessions, plugins, skills, and logs
(allow file-read-data
  (subpath (string-append (param "HOME") "/.codex")))

;; xcodex user config — read-only for inspection/debugging
(allow file-read-data
  (subpath (string-append (param "HOME") "/.config/xcodex")))

;; ============================================================
;; Codex-specific write permissions
;; ============================================================
(allow file-write*
  ;; Codex state, auth, session persistence, plugin cache, logs
  (subpath (string-append (param "HOME") "/.codex")))

;; Shared project sandbox config — prevents privilege escalation on next launch
(deny file-write*
  (literal (string-append (param "PROJECT_DIR") "/.xclaude")))

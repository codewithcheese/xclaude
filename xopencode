#!/bin/zsh
# xopencode — sandboxed OpenCode launcher
# Usage: xopencode [opencode args...]

__xopencode_dir="${0:A:h}"
source "${__xopencode_dir}/xopencode.lib.zsh"

main() {
  local tmpdir="${TMPDIR:-/private/tmp}"
  local home_dir="$(readlink -f "${HOME}")"
  local project_dir="$(readlink -f "${PWD}")"
  tmpdir="$(readlink -f "$tmpdir")"

  local cache_dir="${tmpdir%/T*}/C"
  local volatile_dir="${tmpdir%/T*}/X"

  if [[ ! -f "${__xopencode_dir}/base-common.sb" || ! -f "${__xopencode_dir}/base-opencode.sb" ]]; then
    echo "xopencode: base profile fragments not found at ${__xopencode_dir}/base-common.sb and ${__xopencode_dir}/base-opencode.sb" >&2
    return 1
  fi

  local opencode_bin
  if ! opencode_bin="$(command -v opencode 2>/dev/null)"; then
    echo "xopencode: opencode not found in PATH" >&2
    return 127
  fi
  opencode_bin="$(readlink -f "$opencode_bin")"

  if ! command -v sandbox-exec &>/dev/null; then
    echo "xopencode: sandbox-exec not found; refusing to run OpenCode with --auto outside Seatbelt" >&2
    return 1
  fi

  local xopencode_dir_resolved="$(readlink -f "${__xopencode_dir}")"
  local profile profile_path rc=0

  profile="$(__xopencode_assemble "$project_dir")" || return 1
  profile_path="${tmpdir}/xopencode-$$.sb"
  echo "$profile" > "$profile_path"

  local -a sandbox_args
  sandbox_args=(
    -D "PROJECT_DIR=${project_dir}"
    -D "TMPDIR=${tmpdir}"
    -D "CACHE_DIR=${cache_dir}"
    -D "VOLATILE_DIR=${volatile_dir}"
    -D "HOME=${home_dir}"
    -D "XOPENCODE_DIR=${xopencode_dir_resolved}"
    -D "OPENCODE_BIN=${opencode_bin}"
    -f "$profile_path"
  )

  # Seatbelt is the permission boundary, so bypass OpenCode's application-level
  # approval prompts. The install itself remains read-only inside xopencode;
  # upgrades happen outside while runtime state and plugin caches stay writable.
  env XCLAUDE_ACTIVE=1 XOPENCODE_ACTIVE=1 OPENCODE_DISABLE_AUTOUPDATE=1 \
    sandbox-exec "${sandbox_args[@]}" -- "$opencode_bin" --auto "$@"
  rc=$?

  rm -f "$profile_path"
  return $rc
}

main "$@"

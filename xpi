#!/bin/zsh
# xpi — sandboxed Pi coding agent launcher
# Usage: xpi [pi args...]

__xpi_dir="${0:A:h}"
source "${__xpi_dir}/xpi.lib.zsh"

main() {
  local tmpdir="${TMPDIR:-/private/tmp}"
  local home_dir="$(readlink -f "${HOME}")"
  local project_dir="$(readlink -f "${PWD}")"
  tmpdir="$(readlink -f "$tmpdir")"

  local cache_dir="${tmpdir%/T*}/C"
  local volatile_dir="${tmpdir%/T*}/X"

  if [[ ! -f "${__xpi_dir}/base-common.sb" || ! -f "${__xpi_dir}/base-pi.sb" ]]; then
    echo "xpi: base profile fragments not found at ${__xpi_dir}/base-common.sb and ${__xpi_dir}/base-pi.sb" >&2
    return 1
  fi

  local pi_bin
  if ! pi_bin="$(command -v pi 2>/dev/null)"; then
    echo "xpi: pi not found in PATH" >&2
    return 127
  fi

  if ! command -v sandbox-exec &>/dev/null; then
    echo "xpi: sandbox-exec not found, running without sandbox" >&2
    "$pi_bin" "$@"
    return
  fi

  local xpi_dir_resolved="$(readlink -f "${__xpi_dir}")"
  local profile profile_path rc=0

  profile="$(__xpi_assemble "$project_dir")" || return 1
  profile_path="${tmpdir}/xpi-$$.sb"
  echo "$profile" > "$profile_path"

  local -a sandbox_args
  sandbox_args=(
    -D "PROJECT_DIR=${project_dir}"
    -D "TMPDIR=${tmpdir}"
    -D "CACHE_DIR=${cache_dir}"
    -D "VOLATILE_DIR=${volatile_dir}"
    -D "HOME=${home_dir}"
    -D "XPI_DIR=${xpi_dir_resolved}"
    -f "$profile_path"
  )

  # XCLAUDE_ACTIVE is the shared public marker for tools that only need to
  # know they are inside this project's Seatbelt sandbox. XPI_ACTIVE is a
  # Pi-specific marker. Pi has no built-in approval/sandbox layer to
  # disable, so the binary runs with the user's normal arguments.
  env XCLAUDE_ACTIVE=1 XPI_ACTIVE=1 \
    sandbox-exec "${sandbox_args[@]}" -- "$pi_bin" "$@"
  rc=$?

  rm -f "$profile_path"
  return $rc
}

main "$@"
